<Project Sdk="Microsoft.NET.Sdk">
  <!-- LSE_Doctor: AutoCAD Electrical 2026 plugin (.NET 8). Build on a workstation that has AutoCAD Electrical 2026
       installed, or pass -p:AcadDir="<path to AutoCAD 2026>". Without an install the AutoCAD.NET 25.1 reference package is
       used (compile-time only; nothing from it is copied to the output). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>2026-11-12-r7</InformationalVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>LSE.AutoCADElectrical.ProjectDoctor</RootNamespace>
    <AssemblyName>LSE_Doctor</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AcadDir Condition="'$(AcadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</AcadDir>
    <HasAcad>false</HasAcad>
    <HasAcad Condition="Exists('$(AcadDir)\acdbmgd.dll')">true</HasAcad>
  </PropertyGroup>
  <ItemGroup Condition="'$(HasAcad)' == 'true'">
    <Reference Include="accoremgd"><HintPath>$(AcadDir)\accoremgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acdbmgd"><HintPath>$(AcadDir)\acdbmgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="acmgd"><HintPath>$(AcadDir)\acmgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup><Compile Remove="tests\**" /></ItemGroup>
  <ItemGroup Condition="'$(HasAcad)' != 'true'">
    <PackageReference Include="AutoCAD.NET" Version="25.1.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- The rules JSON lands next to the DLL; the bundled copy of the LSE template text files lands in standard\ as the fallback
         when the vault template path is not reachable. -->
    <None Include="config\LseDoctorRules.json" Link="LseDoctorRules.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="config\standard\*" Link="standard\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
